# Copy to .env.local and fill in. .env.local is gitignored; never commit real values.

# Notion internal integration token. Create the integration at
# https://www.notion.so/profile/integrations, then share the parent page with it.
NOTION_PAT=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Page the two databases are created under. Only scripts/notion-setup.mjs reads it.
NOTION_PARENT_PAGE_ID=00000000-0000-0000-0000-000000000000

# Printed by `node --env-file=.env.local scripts/notion-setup.mjs`.
NOTION_QUESTIONS_DB_ID=00000000-0000-0000-0000-000000000000
NOTION_ANSWERS_DB_ID=00000000-0000-0000-0000-000000000000

# Only needed to regenerate public/options/*.jpg. The images are committed, so this
# is not required to run or deploy the site.
DEEPINFRA_KEY=

# Optional. Signs the partial-response resume cookie. Falls back to NOTION_PAT.
SESSION_SECRET=

# PIN protection for research analytics dashboard
DASHBOARD_PASSWORD=8521
